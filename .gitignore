# Python / virtual environments
.venv/
__pycache__/
*.pyc

# Generated outputs and reports
reports/*
!reports/.gitkeep
data/output/*
!data/output/.gitkeep

# Builder-local native runtime: JDK, Maven repository, JGO/ImageJ caches and
# scratch. Regenerated by run_builder.bat, ~1.6 GB.
data/native_abba_runtime/
# Created by RuntimePaths.create() and always empty: brainglobe-atlasapi reads
# its own config file and ignores the exported BRAINGLOBE_DIR.
data/brainglobe/

# The rendered Ch03 channel. It lives beside the pinned registration inputs but
# is produced by every build (ACTIVE_PATH), ~142 MB.
resources/optional_ch03/waxholm_anatomy_reference.tiff
resources/optional_ch03/waxholm_anatomy_reference.*.partial
data/processed/*
!data/processed/.gitkeep
/data/release_assets/

# Raw data are large and must stay local
/data/raw/bluebrainheadmodels/*
!/data/raw/bluebrainheadmodels/.gitkeep

# BrainGlobe/ABBA local caches and backups
*.tar.gz
*_backup_*/
_paxinos_cleanup_backup_*/

# Stale vendor patch backups and a stray 1-byte file. native_abba_runtime.py
# already excludes exactly these when it vendors the package, so they are never
# used by a build.
vendor/**/*.backup_*
vendor/abba_python_0_11_0/a

# OS/editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local cleanup/archive folders
_local_cleanup_archive/
cleanup_audit/
cleanup_audit*.bat
resources/label_curation/deepseek_acronyms_977_raw.txt
resources/label_curation/PUT_deepseek_acronyms_977_raw_HERE.txt
resources/label_curation/*raw_HERE*.txt
resources/label_curation/*.bak
# Local generated atlas backups
backups/
resources/label_curation/*.backup_before_final_curation.tsv
# final_for_V_0_3.abba is tracked deliberately: it is the authoritative
# registration and only 476 KB, so a clone can build without any release asset.
# Excluded here are the comparison-only ImageJ stack and the QuPath/BDV working
# files, which are never build inputs.
resources/optional_ch03/nissl_registration_0_3_0/*.tif
resources/optional_ch03/nissl_registration_0_3_0/*.tiff
resources/optional_ch03/nissl_registration_0_3_0/*bdv*
resources/optional_ch03/nissl_registration_0_3_0/*.qpproj*
paxinos_watson_rat_nissl_registration_*.zip
PATCH_README_APPLY_CURATED_ACRONYMS.md
README_FINAL_LABEL_CURATION_PATCH*.md
README_VESTIBULAR*.md
rat_curated_acronym_repro_patch.diff
APPLY_FINAL_LABEL_CURATION_DECISIONS.bat
CHECK_FULL_CURATED_ACRONYMS.bat
CHECK_VESTIBULAR_*.bat
